# Copia este archivo como .env. Nunca subas el .env ni escribas claves reales aquí.

# ---------------------------------------------------------------- IA gratuita (todas opcionales)
# Sin ninguna clave el asistente igual responde: usa las preguntas aprobadas, las páginas oficiales y el
# texto literal de las normas. Con una o varias, la IA redacta en lenguaje sencillo citando las fuentes.
# Si un servicio falla o se queda sin cuota, se intenta el siguiente.
#
# Google Gemini, plan gratuito: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODELO=gemini-3.8-flash
#
# Groq, plan gratuito: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODELO=llama-3.3-70b-versatile
#
# Cohere, clave de prueba gratuita: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
#
# Un modelo propio, sin costo por uso (por ejemplo Ollama en el servidor de la Universidad):
# IA_LOCAL_URL=http://localhost:11434/v1/
# IA_LOCAL_MODELO=llama3.2
#
# Orden en que se intentan los servicios configurados.
# IA_PROVEEDORES=local,gemini,groq,cohere

# Búsqueda por significado: auto (modelo local si está instalado, si no Cohere), local, cohere, gemini o ninguna.
# El modelo local es gratis y no envía datos a nadie: pip install fastembed
# BUSQUEDA_SEMANTICA=auto

# Tope diario de llamadas a la IA. Al llegar al tope sigue respondiendo sin IA. Se puede bajar desde el panel.
MAX_LLAMADAS_IA_DIA=900

# ---------------------------------------------------------------- Páginas oficiales
# Lee las páginas de Registro Académico y las noticias de la Universidad al arrancar y cada N horas.
FUENTES_WEB=1
ACTUALIZAR_CADA_HORAS=12
# DOMINIOS_PERMITIDOS=univalle.edu.co

# ---------------------------------------------------------------- Panel y seguridad
# desarrollo crea usuarios de prueba con DEMO_CLAVE. produccion los omite y exige HTTPS para las cookies.
ENTORNO=desarrollo
DEMO_CLAVE=demo-univalle-2026

# Primera cuenta de administración en servidores sin terminal. Solo se usa si todavía no hay ninguna;
# después, cambia la contraseña desde el panel y borra estas dos líneas.
# ADMIN_CORREO=persona@correounivalle.edu.co
# ADMIN_CLAVE=

# Límite de preguntas por persona (por dirección IP).
LIMITE_PREGUNTAS_MINUTO=12
LIMITE_PREGUNTAS_DIA=200

# Páginas adicionales que pueden usar el chat. Los sitios https://*.univalle.edu.co ya están permitidos.
ORIGENES_PERMITIDOS=http://localhost:5500,http://127.0.0.1:5500

# Detrás de un proxy propio que envía X-Forwarded-For (si no, cualquiera podría falsear su IP):
# CONFIAR_PROXY=1

# Para ensayar una demostración como si fuera otro día:
# FECHA_HOY=2026-12-01
