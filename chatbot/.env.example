# Copia este archivo como .env. Nunca subas el .env ni escribas claves reales aquí.

# Clave de producción de Cohere. Sin ella, el asistente funciona sin IA: responde con las
# preguntas aprobadas y cita el texto literal de la norma.
COHERE_API_KEY=

# Contraseña de los usuarios de prueba del panel (solo para la demo local).
# Se usa al crear la base de datos: si la cambias, borra datos/asistente.db.
DEMO_CLAVE=demo-univalle-2026

# Tope de llamadas diarias a la IA, para controlar el gasto.
MAX_LLAMADAS_IA_DIA=2000

# Límite de preguntas por persona (por dirección IP).
LIMITE_PREGUNTAS_MINUTO=12
LIMITE_PREGUNTAS_DIA=200

# Páginas adicionales que pueden usar el chat. Los sitios *.univalle.edu.co ya están permitidos.
ORIGENES_PERMITIDOS=http://localhost:5500,http://127.0.0.1:5500

# En producción, con HTTPS y detrás de un proxy propio:
# COOKIE_SEGURA=1
# CONFIAR_PROXY=1
