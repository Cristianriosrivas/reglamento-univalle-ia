{
  "name": "Asistente Univalle",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "chatbot/README.md"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements.txt -r chatbot/requirements-dev.txt && [ -f chatbot/.env ] || cp chatbot/.env.example chatbot/.env",
  "postAttachCommand": {
    "servidor": "python -m uvicorn app.main:app --app-dir chatbot --host 0.0.0.0 --port 8000"
  },
  "portsAttributes": {
    "8000": { "label": "Chat y panel", "onAutoForward": "openPreview" },
    "8501": { "label": "Versión Streamlit" }
  },
  "forwardPorts": [8000, 8501]
}
